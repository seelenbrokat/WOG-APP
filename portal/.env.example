# Database
DATABASE_URL=postgresql://wog:wog_secret@localhost:5432/wog_portal?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# App
APP_URL=https://wog.logistikberater.at
API_URL=https://wog.logistikberater.at/api
API_PORT=3001
NODE_ENV=production
UPLOAD_DIR=/app/data/uploads
SFTP_INBOUND_DIR=/app/data/sftp/inbound
SFTP_OUTBOUND_DIR=/app/data/sftp/outbound

# GS1 SSCC für Portal-Transportetiketten (Ablöse shipping.NET Labels)
# Prefix wie in bestehenden WOG-SSCCs (09120101…)
SSCC_GS1_COMPANY_PREFIX=9120101
SSCC_EXTENSION_DIGIT=0

# SMTP
SMTP_HOST=mail.logistikberater.at
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Muss zur SMTP_USER-Domain passen (IONOS: sonst 550 Sender not allowed)
SMTP_FROM=info@logistikberater.at

# E-Mail bei neuer Ladeliste / Auftragsbestätigung (PDF als Anhang, Komma-getrennt)
LOADING_LIST_NOTIFY_EMAIL=info@worldofgreen.ch,mb@logistikberater.at
# Entladebericht (ETB) nach WE-Abschluss – Komma-getrennt
GOODS_RECEIPT_ETB_NOTIFY_EMAILS=info@worldofgreen.ch,mb@logistikberater.at

# Soloplan / CarLo Integration (OrderImportPORTAL v6)
SOLOPLAN_ENABLED=false
SOLOPLAN_BASE_URL=
SOLOPLAN_API_KEY=
SOLOPLAN_MODE=file
# Modes: rest | file | stub
# File-API: order (NormalOrder + consignments, Standard) oder consignment
SOLOPLAN_FILE_FORMAT=order
SOLOPLAN_ORDERS_OUT_DIR=/app/data/sftp/outbound/soloplan/orders
SOLOPLAN_OBJECT_OWNER_ID=2
SOLOPLAN_DEFAULT_SENDER_BP=2
SOLOPLAN_DEFAULT_SENDER_MATCHCODE=WOGDIEPO
SOLOPLAN_DEFAULT_SENDER_NAME=WOG Logistics AG
SOLOPLAN_DEFAULT_SENDER_PHONE=+41 71 733 77 00
SOLOPLAN_DEFAULT_SENDER_STREET=Wildenaustraße 22
SOLOPLAN_DEFAULT_SENDER_ZIP=9444
SOLOPLAN_DEFAULT_SENDER_CITY=Diepoldsau
SOLOPLAN_DEFAULT_SENDER_COUNTRY=CH

# Soloplan Zoll-Austausch (EZOLL Hub)
SOLOPLAN_CUSTOMS_ENABLED=false
SOLOPLAN_CUSTOMS_MODE=stub

# LDV (Zollprogramm)
LDV_ENABLED=false
LDV_MODE=stub
LDV_BASE_URL=
LDV_API_KEY=

# Mercurio (Zollprogramm)
MERCURIO_ENABLED=false
MERCURIO_MODE=stub
MERCURIO_BASE_URL=
MERCURIO_API_KEY=

# shipping.NET / OnDot Public API (Status, Sendungen)
SHIPPINGNET_ENABLED=true
SHIPPINGNET_MODE=rest
SHIPPINGNET_BASE_URL=https://shippingnet03.ondot.at/WOG
SHIPPINGNET_PUBLIC_API_BASE=https://shippingnet03.ondot.at/WOG/DataService/PublicApi/v1
SHIPPINGNET_CLIENT_ID=
SHIPPINGNET_ORG_UNIT_ID=
SHIPPINGNET_ORG_UNIT_GUID=
# optional, Format: ClientID:OrgUnitID:OrgUnitGUID
SHIPPINGNET_API_KEY=
# Dokumenttyp für Ablieferbeleg-Upload (muss in OnDot aktiviert sein)
SHIPPINGNET_POD_DOCUMENT_TYPE=DeliveryNote

# Gemeinsames Integrationsverzeichnis (File-Modus)
INTEGRATION_DIR=/app/data/integrations

# Seed admin
SEED_ADMIN_EMAIL=admin@wog.logistikberater.at
SEED_ADMIN_PASSWORD=ChangeMe123!
# true = Admin-Passwort bei jedem Seed überschreiben (nur Erstsetup / Notfall)
SEED_RESET_ADMIN_PASSWORD=false
# false = keine Demo-User/Demo-Sendung anlegen
SEED_DEMO_USERS=true

# SFTPGo Admin (nur localhost:12022 / :18080) – starkes Passwort setzen
SFTPGO_ADMIN_PASSWORD=

# mTrack (ITBinder) – Live-Positionen auf der Karte
MTRACK_ENABLED=false
MTRACK_BASE_URL=https://mtrack.eu
MTRACK_USERNAME=
MTRACK_PASSWORD=
# desktop | app | mobile
MTRACK_LOGIN_TO=desktop
