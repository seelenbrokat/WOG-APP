{
  "name": "wog-portal",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @wog/api",
    "dev:web": "npm run dev -w @wog/web",
    "build": "npm run build -w @wog/shared && npm run build -w @wog/api && npm run build -w @wog/web",
    "build:api": "npm run build -w @wog/shared && npm run build -w @wog/api",
    "build:web": "npm run build -w @wog/web",
    "db:generate": "npm run prisma:generate -w @wog/api",
    "db:migrate": "npm run prisma:migrate -w @wog/api",
    "db:seed": "npm run prisma:seed -w @wog/api",
    "start:api": "npm run start:prod -w @wog/api",
    "start:worker": "npm run start:worker -w @wog/api"
  },
  "engines": {
    "node": ">=20"
  }
}
