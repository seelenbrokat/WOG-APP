{
  "name": "@wog/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP-Server für WOG Portal: Statusabfrage und Auftragserfassung",
  "bin": {
    "wog-mcp": "./dist/index.js"
  },
  "scripts": {
